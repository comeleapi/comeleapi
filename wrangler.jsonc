// Configurazione Cloudflare Workers — sito pubblico + gestionale + API comeleapi.
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Il nome DEVE coincidere con il nome del Worker su Workers Builds.
	"name": "comeleapi",
	"main": "src/worker/index.mjs",
	"compatibility_date": "2026-07-27",
	// Il sito è servito solo dai domini reali: workers.dev e preview URL
	// disattivati per evitare contenuto duplicato indicizzabile.
	"workers_dev": false,
	"preview_urls": false,
	// Smart Placement: esegue il Worker vicino a D1 (EEUR) riducendo i
	// round-trip delle richieste API che fanno più query per invocazione.
	"placement": { "mode": "smart" },
	"assets": {
		// Output della build (npm run build) servito come static assets:
		// richieste gratuite e illimitate, il Worker non viene invocato.
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		// Solo queste rotte invocano il Worker prima degli asset statici:
		// API, gate di autenticazione del gestionale (pagine + admin.js)
		// e immagini caricate.
		"run_worker_first": [
			"/api/*",
			"/admin*",
			"/login*",
			"/assets/js/admin.js",
			"/uploads/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "comeleapi-db",
			// Id restituito da `wrangler d1 create comeleapi-db` (account cliente).
			"database_id": "313f23ff-3849-4c4b-8ca2-7c11854b263b"
		}
	],
	"observability": {
		"enabled": true
	}
	// Secrets di produzione (wrangler secret put):
	//   SESSION_SECRET, ADMIN_USER, ADMIN_PASSWORD,
	//   VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT
}