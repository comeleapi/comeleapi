# ============================================================
# comeleapi — Segreti e variabili (Cloudflare Workers + D1)
#
# Sviluppo locale (wrangler dev): copia questo file in `.dev.vars`
#   e compila i valori. Wrangler li carica automaticamente per il
#   Worker locale con database D1 locale.
#
# Produzione: NON usare file. Imposta ogni valore come secret con
#   `wrangler secret put NOME` (oppure dalla dashboard del Worker).
# ============================================================

# Firma dei cookie di sessione (HMAC). Stringa lunga e casuale.
#   Genera con: node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Amministratore iniziale (bootstrap al primo login).
#   ADMIN_PASSWORD: almeno 14 caratteri, mai una password predefinita.
#   Il bootstrap mantiene un solo utente con ruolo admin.
ADMIN_USER=
ADMIN_PASSWORD=

# VAPID — notifiche push (Web Push, reimplementate con WebCrypto).
#   Riusa le chiavi VAPID esistenti (data/vapid.json) oppure generane di nuove.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sara.bordenga@gmail.com

# ------------------------------------------------------------
# Solo per la migrazione una-tantum dei dati da Supabase a D1
# (scripts/migrate-to-d1.mjs). Facoltativi: senza questi valori
# lo script esporta dai JSON locali in data/.
# ------------------------------------------------------------
# SUPABASE_URL=https://PROGETTO.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...(service_role key dalla dashboard Supabase)
